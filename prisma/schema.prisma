generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// NextAuth Required Models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  
  access_token       String?  
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Application Models
enum Role {
  STUDENT
  TUTOR
  ADMIN
}

enum TutorStatus {
  PENDING
  APPROVED
  REJECTED
  INACTIVE
  SUSPENDED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(STUDENT)
  timezone      String?   // e.g. "America/New_York"
  password      String?
  onboardingCompleted Boolean @default(false)
  primaryGoal   String?
  age           Int?
  grade         String?
  curriculum    String?
  points        Int       @default(0)
  
  // Password Reset (P1-3)
  passwordResetToken       String?
  passwordResetExpires     DateTime?

  // Email Verification (P0-7)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?

  // Age Gating & Minor Protection (P0-8)
  dateOfBirth              DateTime?
  isMinor                  Boolean?  @default(false)
  parentEmail              String?
  guardianConsentGiven     Boolean   @default(false)

  // Account Security & Brute Force Lockout (P0-12)
  failedLoginCount         Int       @default(0)
  lockedUntil              DateTime?
  lastLoginAt              DateTime?
  accountSuspended         Boolean   @default(false)
  suspendedReason          String?

  accounts      Account[]
  sessions      Session[]
  
  // Custom platform relations
  tutorProfile  TutorProfile?
  
  // Bookings where this user is the student
  studentBookings Booking[] @relation("StudentBookings")
  
  // Reviews given by this user (as a student)
  reviewsGiven    Review[]
  
  // Workshops enrolled
  workshopEnrollments WorkshopEnrollment[] @relation("WorkshopEnrollments")
  
  // Incident reports
  reportsFiled    IncidentReport[] @relation("ReportsFiled")
  reportsReceived IncidentReport[] @relation("ReportsReceived")

  // Admin application audits
  applicationAuditLogs ApplicationAuditLog[]

  // Homework & Community relations
  homeworkRequests  HomeworkRequest[]
  communityMessages CommunityMessage[]

  // Parent-managed child profiles (Phase 2)
  childProfiles     ChildProfile[]      @relation("ParentChildProfiles")

  @@index([passwordResetToken])
  @@index([emailVerificationToken])
}

model TutorProfile {
  id              String      @id @default(cuid())
  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  bio             String?     
  school          String?
  experience      String?     
  currentGrade    String?
  languages       String?     // Comma separated list for now
  teachingStyles  String?     // Comma separated tags
  
  status          TutorStatus @default(PENDING)
  approvedAt      DateTime?
  lastReminderSentAt DateTime?
  volunteerHours  Float       @default(0.0)

  curricula       String?     // Comma separated list e.g. "IB, AP, CBSE, IGCSE, US Common Core"
  minAge          Int?
  maxAge          Int?
  targetGrades    String?

  academicScores       String?     
  reportCardUrl        String?     
  reportCardName       String?
  reportCardStorageKey String?
  reportCardMimeType   String?

  gradeLevels     GradeLevel[]
  subjects        Subject[]
  availabilities  Availability[]
  
  // Bookings where this user is the tutor
  tutorBookings   Booking[] @relation("TutorBookings")
  
  // Group workshops hosted by this tutor
  workshops       Workshop[] @relation("TutorWorkshops")
  
  // Reviews received by this tutor
  reviews         Review[]

  // Homework requests claimed/answered by this tutor
  claimedHomeworks HomeworkRequest[]

  // Training module completions (Phase 4)
  trainingModules  TutorTraining[]

  // Volunteer hour audit log (Phase 5)
  hourAudits       VolunteerHourAudit[]
  
  // Application audit logs (Phase 6)
  applicationAuditLogs ApplicationAuditLog[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GradeLevel {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. "Grade 1", "High School", etc.
  category    String?  // e.g. "Elementary", "Middle", "High"
  
  tutors      TutorProfile[]
}

model Subject {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. "Math", "Science", "Algebra I"
  category    String?  // e.g. "High School", "Elementary"
  
  tutors      TutorProfile[]
}

model Availability {
  id            String       @id @default(cuid())
  tutorId       String
  tutor         TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  
  dayOfWeek     Int          // 0 = Sunday, 1 = Monday, etc.
  startTime     String       // e.g. "17:00" in 24hr format
  endTime       String       // e.g. "20:00" in 24hr format
  timezone      String       // The timezone this was created in, fallback to Tutor's timezone
  
  @@unique([tutorId, dayOfWeek, startTime, endTime])
  @@index([tutorId])
}

enum BookingStatus {
  CONFIRMED
  CANCELED
  COMPLETED
}

model Booking {
  id              String        @id @default(cuid())
  
  studentId       String
  student         User          @relation("StudentBookings", fields: [studentId], references: [id])
  
  tutorId         String
  tutor           TutorProfile  @relation("TutorBookings", fields: [tutorId], references: [id])
  
  subject         String
  grade           String
  topic           String
  helpNeeded      String?       
  
  startTime       DateTime      // Stored in UTC
  endTime         DateTime      // Stored in UTC
  
  status          BookingStatus @default(CONFIRMED)
  studentAttended Boolean       @default(false)
  studentConfirmedAt DateTime?
  hoursCredited   Boolean       @default(false)
  zoomLink        String?       
  recordingUrl    String?       
  checkUpNote     String?       
  checkUpSent     Boolean       @default(false)
  cancelReason    String?       
  maxParticipants Int           @default(1)
  idempotencyKey  String?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([studentId])
  @@index([tutorId])
  @@index([idempotencyKey])
}

model Program {
  id               String       @id @default(cuid())
  slug             String       @unique
  emoji            String
  title            String
  shortDescription String
  longDescription  String       
  subjects         String[]
  gradeLevels      String[]
  format           String
  duration         String
  outcomes         String[]
  
  faqs             ProgramFaq[]

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model ProgramFaq {
  id         String   @id @default(cuid())
  question   String
  answer     String   
  
  programId  String
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  
  @@index([programId])
}

model Story {
  id          String   @id @default(cuid())
  quote       String   
  name        String
  subject     String
  isPublished Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id          String       @id @default(cuid())
  tutorId     String
  tutor       TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  studentId   String
  student     User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bookingId   String?
  
  rating      Int          // e.g. 1-5
  comment     String?      
  
  createdAt   DateTime     @default(now())
  
  @@index([tutorId])
  @@index([studentId])
}

enum WorkshopStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  CANCELED
}

model Workshop {
  id          String         @id @default(cuid())
  tutorId     String
  tutor       TutorProfile   @relation("TutorWorkshops", fields: [tutorId], references: [id], onDelete: Cascade)
  
  title       String
  description String         
  subject     String
  grade       String
  curriculum  String?
  
  startTime   DateTime
  endTime     DateTime
  
  zoomLink     String?        
  recordingUrl String?        
  checkUpNote  String?        
  maxCapacity  Int            @default(10)
  status       WorkshopStatus @default(UPCOMING)
  
  enrollments WorkshopEnrollment[]
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  @@index([tutorId])
}

model WorkshopEnrollment {
  id          String       @id @default(cuid())
  workshopId  String
  workshop    Workshop     @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  studentId   String
  student     User         @relation("WorkshopEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime     @default(now())
  
  @@unique([workshopId, studentId])
  @@index([workshopId])
  @@index([studentId])
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model IncidentReport {
  id             String       @id @default(cuid())
  reporterId     String?
  reporter       User?        @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: SetNull)
  
  reportedUserId String?
  reportedUser   User?        @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: SetNull)
  
  bookingId      String?
  category       String       // e.g. "Inappropriate Behavior", "No-show", "Harassment", "Safety Concern"
  description    String       
  status         ReportStatus @default(PENDING)
  adminNotes     String?      
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  
  @@index([reporterId])
  @@index([reportedUserId])
}

model HomeworkRequest {
  id              String        @id @default(cuid())
  studentId       String
  student         User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  subject         String
  question        String        
  preferredFormat String        @default("zoom") // "zoom" or "chat"
  grade           String?
  curriculum      String?
  
  status          String        @default("OPEN") // "OPEN", "ANSWERED", "RESOLVED"
  answer          String?       
  
  tutorId         String?
  tutor           TutorProfile? @relation(fields: [tutorId], references: [id], onDelete: SetNull)
  
  zoomLink        String?       
  isPrivate       Boolean       @default(true)
  deletedAt       DateTime?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([studentId])
  @@index([tutorId])
}

model CommunityMessage {
  id              String        @id @default(cuid())
  channel         String        @default("General")
  
  authorId        String?
  author          User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName      String
  authorEmail     String?
  authorRole      String
  authorInitials  String
  authorColor     String
  
  content         String        
  reactions       Json?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([authorId])
}

// ─── Phase 2: Parent-Managed Child Profiles ───────────────────────────────────

model ChildProfile {
  id                  String   @id @default(cuid())
  parentId            String
  parent              User     @relation("ParentChildProfiles", fields: [parentId], references: [id], onDelete: Cascade)

  firstName           String
  lastInitial         String   // Privacy: Only store last initial for display (e.g. "Priya K.")
  grade               String   // e.g. "Grade 4"
  age                 Int?
  learningPreferences String?   // JSON array of preferences e.g. ["visual", "step-by-step"]
  notes               String?   // Parent notes for tutors (no diagnosis required)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@index([parentId])
}

// ─── Phase 4: Tutor Training Module Completion ────────────────────────────────

model TutorTraining {
  id             String       @id @default(cuid())
  tutorId        String
  tutor          TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  moduleId       Int          // 1-5 matching the training module IDs
  moduleTitle    String
  completedAt    DateTime     @default(now())
  quizPassed     Boolean      @default(false)

  @@unique([tutorId, moduleId])
  @@index([tutorId])
}

// ─── Phase 5: Volunteer Hour Audit Trail ─────────────────────────────────────

model VolunteerHourAudit {
  id           String       @id @default(cuid())
  tutorId      String
  tutor        TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  adjustedBy   String       // Admin user ID
  oldHours     Float
  newHours     Float
  reason       String        // Required reason for the adjustment

  createdAt    DateTime     @default(now())
  
  @@index([tutorId])
}

// ─── Phase 6: Application Audit Logs ─────────────────────────────────────────

model ApplicationAuditLog {
  id          String       @id @default(cuid())
  tutorId     String
  tutor       TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  adminId     String
  admin       User         @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  action      String       // e.g. "APPROVED", "REJECTED", "SUSPENDED", "REACTIVATED"
  reason      String?
  
  createdAt   DateTime     @default(now())
  
  @@index([tutorId])
  @@index([adminId])
}

